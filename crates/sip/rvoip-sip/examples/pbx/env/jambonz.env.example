# The managed release lab writes live values to
# $RVOIP_PBX_LOCAL_ENV_ROOT/jambonz/jambonz-local.env. These defaults describe
# its Docker bridge on a Linux release worker.
JAMBONZ_UDP_ADDR=172.39.0.10:5060
JAMBONZ_SIP_DOMAIN=sip.rvoip.test
JAMBONZ_PASSWORD=1234
RVOIP_LOCAL_IP=0.0.0.0
RVOIP_ADVERTISED_IP=172.39.0.1
RVOIP_MEDIA_ADVERTISED_IP=172.39.0.1
JAMBONZ_RTP_START=10000
JAMBONZ_RTP_END=20000
JAMBONZ_POST_REGISTER_SETTLE_SECS=2
JAMBONZ_TEST_TIMEOUT_SECS=90

# Jambonz 0.9.9 is UDP/plain-RTP in this release profile. TLS/SRTP is a
# separately versioned future profile and is not inferred from this file.
