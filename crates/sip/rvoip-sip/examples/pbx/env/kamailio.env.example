# Copy to env/kamailio.env or let infra/release-runners/pbx/kamailio/up.sh
# generate ~/Developer/kamailio/kamailio-local.env, which run.sh sources.
PBX_PROVIDER=kamailio
KAMAILIO_UDP_ADDR=192.168.64.2:5072
KAMAILIO_PASSWORD=password123

# The address the Kamailio/rtpengine VM can reach this machine at.
RVOIP_LOCAL_IP=0.0.0.0
RVOIP_ADVERTISED_IP=192.168.64.1
RVOIP_MEDIA_ADVERTISED_IP=192.168.64.1

# rtpengine's relay range, used by PBX_DIAG's pcap filter.
KAMAILIO_RTP_START=23000
KAMAILIO_RTP_END=23200

KAMAILIO_POST_REGISTER_SETTLE_SECS=1

# Endpoint port bases live at 35xxx (see endpoint_defaults): clear of the
# asterisk (5xxx), freeswitch (15xxx) and sip-proxy interop (25xxx) blocks,
# so all the labs can run side by side.
#
# UDP only for now: the lab has no TLS listener, and run.sh skips TLS cells
# for this provider. amr_transcode_call is unsupported (a proxy does not
# transcode); amr_call sweeps all four AMR profiles because rtpengine relays
# every framing untouched.
