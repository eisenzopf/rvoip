<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="rvoip proxy full INVITE dialog UAS">
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="X-Interop-Scenario: invite-success"
            search_in="msg" check_it="true" assign_to="1" />
      <ereg regexp="m=audio 40000 RTP/AVP 0"
            search_in="msg" check_it="true" assign_to="2" />
      <log message="validated INVITE marker=[$1] media=[$2]" />
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=interop-uas-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:agent@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <!-- Keep the provisional response independently observable through peers
       that coalesce an immediately superseding final response. -->
  <pause milliseconds="100" />

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=interop-uas-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:agent@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=interop 2 2 IN IP[local_ip_type] [local_ip]
      s=rvoip-proxy-interop
      c=IN IP[local_ip_type] [local_ip]
      t=0 0
      m=audio 40002 RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK" />
  <recv request="BYE" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:agent@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>
</scenario>
